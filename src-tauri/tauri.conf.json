{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atiga Amp", "version": "0.1.0", "identifier": "com.atiga.amp",
  "build": { "beforeDevCommand": "npm run dev -- --strictPort", "devUrl": "http://127.0.0.1:5174", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": { "windows": [{ "title": "Atiga Amp", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }], "security": { "csp": null, "assetProtocol": { "enable": true, "scope": ["**"] } } },
  "bundle": { "active": true, "targets": "all", "icon": ["../icon.svg"] }
}
