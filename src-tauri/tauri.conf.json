{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Atiga Amp", "version": "0.1.6", "identifier": "com.atiga.amp",
  "build": { "beforeDevCommand": "npm run dev -- --strictPort", "devUrl": "http://127.0.0.1:5174", "beforeBuildCommand": "npm run build", "frontendDist": "../dist" },
  "app": {
    "windows": [{ "label": "main", "title": "Atiga Amp", "width": 1280, "height": 800, "minWidth": 900, "minHeight": 600 }],
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; font-src 'self'; img-src 'self' asset: http://asset.localhost blob: data:; media-src 'self' asset: http://asset.localhost blob:; connect-src ipc: http://ipc.localhost 'self' asset: http://asset.localhost; worker-src 'self' blob:",
      "assetProtocol": { "enable": true, "scope": ["$APPDATA/library/**"] }
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Music",
    "shortDescription": "Pemutar musik lokal untuk Linux",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.ico"]
  }
}
